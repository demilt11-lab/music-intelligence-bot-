  totalListeners   BigInt?
  totalFollowers   BigInt?

  platformStreams   Json?
  platformListeners Json?
  platformFollowers Json?

  playlistCount          Int?
  editorialPlaylistCount Int?
  indiePlaylistCount     Int?
  playlistReach          BigInt?

  chartCountries Json?
