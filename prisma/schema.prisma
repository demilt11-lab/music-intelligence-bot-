// ─────────────────────────────────────────────
// ML labels & predictions
// ─────────────────────────────────────────────

model TrackTrendLabel {
  id          Int      @id @default(autoincrement())
  trackId     Int
  genre       String?
  code2       String?
  label       String
  firstSeenAt DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, genre, code2])
  @@map("track_trend_labels")
}

model TrackTrendPrediction {
  id           Int      @id @default(autoincrement())
  trackId      Int
  genre        String?
  code2        String?
  label        String
  probViral    Float
  probTrending Float
  probPopular  Float
  probNone     Float
  modelName    String
  modelVersion String
  predictedAt  DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, genre, code2, modelName, modelVersion])
  @@map("track_trend_predictions")
}

model PredictionOutcome {
  id             Int       @id @default(autoincrement())
  trackId        Int?
  artistId       Int?
  predictionType String    // "trend_label" | "break_probability" | "viral_score"
  predictedValue String    // The predicted value (e.g. "VIRAL", "0.85")
  predictedAt    DateTime
  evaluatedAt    DateTime?
  actualValue    String?   // What actually happened 30 days later
  wasCorrect     Boolean?
  modelName      String
  modelVersion   String?
  createdAt      DateTime  @default(now())

  @@index([trackId, predictedAt])
  @@index([artistId, predictedAt])
  @@index([predictionType, predictedAt])
  @@map("prediction_outcomes")
}

model ModelAccuracyReport {
  id                 Int      @id @default(autoincrement())
  modelName          String
  evaluationDate     DateTime
  windowDays         Int      // e.g. 30
  totalPredictions   Int
  correctPredictions Int
  accuracy           Float    // correctPredictions / totalPredictions
  precision          Float?
  recall             Float?
  f1Score            Float?
  notes              String?
  createdAt          DateTime @default(now())

  @@unique([modelName, evaluationDate, windowDays])
  @@map("model_accuracy_reports")
}

model TrackAudioCluster {
  id               Int      @id @default(autoincrement())
  trackId          Int      @unique
  clusterId        Int
  isHotCluster     Boolean  @default(false)
  clusterViralMean Float?
  updatedAt        DateTime @default(now())

  @@index([clusterId])
  @@index([isHotCluster])
  @@map("track_audio_clusters")
}

model AnomalyLog {
  id           Int      @id @default(autoincrement())
  trackId      Int?
  artistId     Int?
  metric       String
  zScore       Float
  currentValue Float
  baselineMean Float
  baselineStd  Float
  severity     String
  detectedAt   DateTime @default(now())
  acknowledged Boolean  @default(false)

  @@index([trackId, detectedAt])
  @@index([severity, detectedAt])
  @@map("anomaly_log")
}

// ─── Predictive A&R — Feature Engineering ─────────────────────────────────────

model ArtistFeaturesDaily {
  id                          Int      @id @default(autoincrement())
  artistId                    Int
  date                        DateTime @db.Date

  // Spotify listener growth %
  listenersGrowth7d           Float?
  listenersGrowth14d          Float?
  listenersGrowth30d          Float?
  listenersGrowth90d          Float?

  // Follower growth %
  followersGrowth7d           Float?
  followersGrowth30d          Float?

  // Velocity = change per day over last 7d; acceleration = delta of velocity
  listenersVelocity7d         Float?
  listenersAcceleration7d     Float?

  // TikTok UGC momentum
  tiktokVideosPerDay7d        Float?
  tiktokViewsGrowth7d         Float?

  // Cross-platform breadth
  crossPlatformSpikes7d       Int?     // # platforms with >20% growth this week

  // Virality ratios
  streamsPerPlaylistAdd7d     Float?
  savesPerStream30d           Float?
  igEngagementPerFollower30d  Float?
  commentsPerView30d          Float?

  // Robustness / consistency
  growthConsistency30d        Float?   // 0–1: how steady growth has been

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date])
  @@index([artistId, date])
  @@map("artist_features_daily")
}

// ─── Predictive A&R — Composite Scores ────────────────────────────────────────

model ArtistScoresDaily {
  id                   Int      @id @default(autoincrement())
  artistId             Int
  date                 DateTime @db.Date

  heatScore            Float?   // 1–10 composite momentum score
  stabilityScore       Float?   // 1–10 consistency / low-volatility score
  platformBalanceScore Float?   // 1–10 cross-platform evenness

  breakoutProb30d      Float?   // 0–1 ML model output

  heatScoreRaw         Float?   // pre-sigmoid raw value
  stabilityScoreRaw    Float?
  modelVersion         String?  // e.g. "xgb-v1"

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date])
  @@index([date, breakoutProb30d])
  @@index([date, heatScore])
  @@map("artist_scores_daily")
}

// ─── Predictive A&R — ML Training Data ────────────────────────────────────────

model TrainingExample {
  id              Int      @id @default(autoincrement())
  artistId        Int
  snapshotDate    DateTime @db.Date
  breakoutLabel   Int      // 0 = control, 1 = breakout

  // Feature snapshot (mirrors ArtistFeaturesDaily at snapshot_date)
  listenersGrowth7d          Float?
  listenersGrowth30d         Float?
  listenersGrowth90d         Float?
  listenersVelocity7d        Float?
  listenersAcceleration7d    Float?
  tiktokVideosPerDay7d       Float?
  tiktokViewsGrowth7d        Float?
  crossPlatformSpikes7d      Int?
  streamsPerPlaylistAdd7d    Float?
  savesPerStream30d          Float?
  igEngagementPerFollower30d Float?
  growthConsistency30d       Float?
  baselineMonthlyListeners   Float?  // listeners at snapshot_date (for breakout threshold)

  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, snapshotDate])
  @@map("training_examples")
}
