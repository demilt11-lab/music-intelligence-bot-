  audience   String?
  spins      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, date, locationId, marketId, formatId], map: "luminate_airplay_unique_key")
  @@map("luminate_airplay")
}
