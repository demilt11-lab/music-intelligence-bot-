model ArtistTrajectorySnapshot {
  id          BigInt   @id @default(autoincrement())
  artistId    BigInt
  date        DateTime

  // rolling windows
  streams7d       BigInt
  streams28d      BigInt
  streams90d      BigInt
  streams7dDelta  Float
  streams28dDelta Float
  streams90dDelta Float

  listeners28d       BigInt?
  listenersDelta28d  Float?
  followersDelta28d  Float?
  playlistsDelta28d  Float?
  editorialAdds28d   Int?
  removals28d        Int?

  tiktokVelocityScore   Float?
  chartVelocityScore    Float?
  airplayVelocityScore  Float?

  primaryGenre   String?
  primaryCode2   String?
  breakoutCities Json?

  status         String // ABOUT_TO_BREAK | GROWING | DECLINING | STABLE
  statusScore    Float
  breakProbability Float?

  spotifyBreakProb    Float?
  spotifyModelName    String?
  spotifyModelVersion String?

  createdAt     DateTime @default(now())

  @@index([artistId, date])
  @@index([status])
  @@index([primaryGenre])
  @@index([primaryCode2])
  @@map("artist_trajectory_snapshots")
}

model TrackTrendLabel {
  id          Int      @id @default(autoincrement())
  trackId     Int
  genre       String?
  code2       String?  // ISO2 country or GLOBAL
  label       String   // VIRAL | TRENDING | POPULAR | NONE
  firstSeenAt DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, genre, code2])
  @@map("track_trend_labels")
}
model TrackTrendPrediction {
  id          Int      @id @default(autoincrement())
  trackId     Int
  genre       String?
  code2       String?  // ISO2 country or GLOBAL
  // model outputs
  label       String   // predicted class: VIRAL | TRENDING | POPULAR | NONE
  probViral   Float
  probTrending Float
  probPopular Float
  probNone    Float
  modelName   String
  modelVersion String
  predictedAt DateTime @default(now())

  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, genre, code2, modelName, modelVersion])
  @@map("track_trend_predictions")
}
model ArtistSpotifyReleaseStats {
  id                Int      @id @default(autoincrement())
  artistId          Int
  snapshotDate      DateTime

  // core counts
  numTracks         Int      // number of releases considered (<= 10)
  windowDays        Int      // days back we looked (e.g., 365)

  // aggregate stats over last 10 tracks in last year
  totalStreams      BigInt
  avgStreams        Float
  medianStreams     Float
  maxStreams        BigInt
  minStreams        BigInt

  // distribution shape
  stdStreams        Float
  numAbove100k      Int
  numAbove1M        Int

  // latest track stats (most recent release)
  latestTrackId     Int?
  latestReleaseDate DateTime?
  latestStreams28d  BigInt?   // Spotify streams in first 28 days
  latestTotalStreams BigInt?

  // cadence
  avgDaysBetweenReleases Float?

  // binary label for training: did they break later?
  popularWithin6m   Boolean? // null for live data, set for historical training

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([artistId, snapshotDate])
  @@index([artistId, snapshotDate])
  @@map("artist_spotify_release_stats")
}
