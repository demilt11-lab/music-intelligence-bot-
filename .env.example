# =============================================================================
# Music Intelligence API — environment variables
# -----------------------------------------------------------------------------
# Copy to `.env.local` for development and fill in real values.
# In production (Vercel) set these in Project → Settings → Environment Variables.
# Variables marked (required) MUST be set or the app/feature will fail at runtime.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle — never put
# privileged secrets there.
# =============================================================================

# ─── Database (required) ──────────────────────────────────────────────────────
# Supabase: Settings → Database → Connection string → Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase: Settings → Database → Connection string → Session pooler / Direct (port 5432)
# Used by Prisma migrations only — required for Vercel deploy
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── ML Service ──────────────────────────────────────────────────────────────
# URL of the FastAPI ML service (uvicorn ml.api.artist_trajectory_service:app)
# In production: the host/port where the Python service is deployed (e.g. Railway, Fly.io)
ML_ARTIST_TRAJECTORY_URL="http://localhost:8000/v1/artist/trajectory/predict"

# Internal base URL for Next.js → Next.js API calls (used by server components & crons)
INTERNAL_API_BASE_URL="http://localhost:3000"
INTERNAL_ARTIST_TRAJECTORY_URL="http://localhost:3000/api/v1/artist/trajectory/predict"

# ─── Generative AI (Anthropic Claude) ────────────────────────────────────────
# Powers Buddy's A&R briefings (lib/ai/*). When unset, the app falls back to a
# deterministic, data-derived summary and never shows the "AI briefing" badge.
# Get a key: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="your_anthropic_api_key"
# Optional model override. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL="claude-opus-4-8"

# ─── Third-party data APIs ───────────────────────────────────────────────────
# Songstats / radio airplay
SONGSTATS_API_KEY="your_songstats_api_key"
SONGSTATS_API_BASE_URL="https://api.songstats.com/enterprise/v1"

# Soundcharts
SOUNDCHARTS_APP_ID="your_soundcharts_app_id"
SOUNDCHARTS_API_KEY="your_soundcharts_api_key"

# Luminate
LUMINATE_API_KEY="your_luminate_api_key"
LUMINATE_BASE_URL="https://api.luminatedata.com"

# Spotify Web API (client-credentials flow) — used by talent-scout + ingest:spotify
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# YouTube Data API v3 — used by ingest:youtube
YOUTUBE_API_KEY="your_youtube_api_key"

# Shazam (RapidAPI host) — used by ingest:shazam
SHAZAM_API_KEY="your_shazam_api_key"
SHAZAM_BASE_URL="https://shazam.p.rapidapi.com"

# Firecrawl — used by lib/writersProducers/externalSearch.ts (blog article search)
FIRECRAWL_API_KEY="your_firecrawl_api_key"

# Crawler API (crawl4ai) — self-hosted headless-browser crawling service, see
# services/crawler-api. Used by ingest:billboard, ingest:crawl-dsp-apple,
# ingest:crawl-social-x, ingest:crawl-radio-spins for pages that block plain
# HTTP fetches or only render content via JS (DSP web players, social
# profiles, radio station sites, chart sites).
CRAWLER_API_URL="http://localhost:8090"
# Optional — only enforced by services/crawler-api when set.
CRAWLER_API_KEY="your_crawler_api_key"

# Meta / Instagram Graph API — used by ingest:instagram
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
IG_USER_ID="your_instagram_business_user_id"

# SearchAPI — used by ingest:googletrends
SEARCHAPI_KEY="your_searchapi_key"

# TikTok (official API + RapidAPI fallback) — used by ingest:tiktok
TIKTOK_CLIENT_KEY="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"
RAPIDAPI_KEY="your_rapidapi_key"

# ─── Redis (rate limiting) ────────────────────────────────────────────────────
# Optional but recommended in production. If unset, rate limiting is disabled.
# Upstash Redis: https://console.upstash.com → your database → REST API
UPSTASH_REDIS_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_TOKEN="your_upstash_redis_token"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Restrict API CORS to your production domain. Defaults to localhost:3000 in dev.
# NEVER leave this as * in production — it opens your API to any origin.
ALLOWED_ORIGIN="https://app.nov8te.com"

# ─── Cron security (required in production) ───────────────────────────────────
# Random secret used to authenticate Vercel cron → /api/cron/* calls.
# The app FAILS CLOSED: if CRON_SECRET is unset, all /api/cron/* calls return 401.
# Generate: openssl rand -base64 32
CRON_SECRET="your_cron_secret_here"

# ─── Internal admin API security (required in production) ────────────────────
# Bearer token for /api/internal/* management-plane endpoints (create-tenant,
# create-api-key, rotate-api-key scripts). FAILS CLOSED if unset.
# Generate: openssl rand -base64 32
INTERNAL_ADMIN_SECRET="your_internal_admin_secret_here"


# ─── Authentication (required in production) ─────────────────────────────────
# HMAC key for session cookies. REQUIRED in production — the app fails closed
# (503 on every page) without it. In dev, leaving it unset disables auth.
# Generate: openssl rand -base64 32
AUTH_SECRET="your_auth_secret_here"

# Optional: prisma/seed.ts provisions this admin when BOTH are set.
# Never ship a default password — unset means no user is created.
SEED_ADMIN_EMAIL="admin@workspace.local"
SEED_ADMIN_PASSWORD=""

# ─── App / Dashboard ─────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Tenant slug the first-party web UI operates under (resolved server-side;
# created automatically on first use). No API key is shipped to the browser.
UI_TENANT_SLUG="workspace"

# Talent Scout fallback: when no UGC/ML/chart data exists, return clearly
# labeled sample rows (source="sample") instead of an empty list. Off by
# default — only enable for layout previews, never investor-facing demos.
SCOUT_SAMPLE_FALLBACK="0"

NODE_ENV="development"

# ─── Python ML training scripts (ml/training/*) ──────────────────────────────
# These scripts call back into the public API to collect features.
# DATABASE_URL above is reused by the Python services as well.
API_BASE="http://localhost:3000"
API_KEY="your_ml_service_api_key"
MONITOR_INTERVAL="3600"
