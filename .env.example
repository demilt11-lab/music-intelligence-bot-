# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://music_user:password@localhost:5432/music_intelligence"
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# ── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────
API_KEY_SALT="change-me-to-32-random-bytes-hex"

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Monitoring ────────────────────────────────────────────
LOG_LEVEL=info
METRICS_ENABLED=true
SENTRY_DSN=

# ── ML Model ─────────────────────────────────────────────
ML_MODEL_PATH=./ml/checkpoints/best_model.pt
ML_MODEL_VERSION=1.0.0-rules
ML_CACHE_TTL_HOURS=6
TRAJECTORY_SCORING_VERSION=1.0.0

# ── Build info (set by CI) ─────────────────────────────────
BUILD_SHA=
DEPLOYED_AT=
