{
  "name": "music-intelligence-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "create-tenant": "ts-node scripts/create-tenant.ts",
    "create-api-key": "ts-node scripts/create-api-key.ts",
    "tenant-automation": "ts-node scripts/automation/tenantAutomation.ts",
    "match-catalog": "ts-node scripts/match-catalog.ts",
    "etl:artist-daily": "ts-node jobs/etl/artist_daily_stats.ts",
    "etl:artist-trajectory": "ts-node jobs/etl/artist_trajectory_snapshots.ts",
    "etl:artist-all": "node scripts/run_artist_etl.js",
    "etl:track-trends": "ts-node jobs/etl/track_trend_labels.ts",
    "etl:artist-spotify-release-stats": "ts-node jobs/etl/artist_spotify_release_stats.ts",
    "etl:artist-spotify-release-labels": "ts-node jobs/etl/artist_spotify_release_stats_labels.ts",
    "etl:ugc": "ts-node jobs/etl/ugcTracks.ts",
    "export:artist-training": "ts-node scripts/export_artist_trajectory_training.ts",
    "export:artist-trajectory-features": "ts-node scripts/export_artist_trajectory_features.ts",
    "export:track-trend-training": "ts-node scripts/export_track_trend_training.ts",
    "export:artist-spotify-trend-training": "ts-node scripts/export_artist_spotify_trend_training.ts",
    "export:viral-training": "python ml/pipeline/feature_store.py --output data/viral_training_features.parquet",
    "export:popularity-training": "python ml/pipeline/feature_store.py --output data/popularity_training_features.parquet",
    "export:trend-training": "python ml/pipeline/feature_store.py --output data/trend_training_features.parquet",
    "ml:feedback:collect": "python ml/feedback/collector.py --since-days 30",
    "ml:viral:train": "python -m ml.training.train_viral_predictor",
    "ml:viral:full": "npm run export:viral-training && npm run ml:feedback:collect && npm run ml:viral:train",
    "ml:popularity:train": "python -m ml.training.train_popularity_predictor",
    "ml:popularity:full": "npm run export:popularity-training && npm run ml:feedback:collect && npm run ml:popularity:train",
    "ml:trend:train": "python -m ml.training.train_trend_classifier",
    "ml:trend:full": "npm run export:trend-training && npm run ml:feedback:collect && npm run ml:trend:train",
    "ml:track-trend:train": "python ml/track_trend_model.py --mode train --input output/track_trend_training.csv",
    "ml:track-trend:predict": "python ml/track_trend_model.py --mode predict --input output/track_trend_training.csv --output output/track_trend_predictions.csv",
    "ml:track-trend:import": "ts-node scripts/import_track_trend_predictions.ts",
    "ml:track-trend:full": "npm run export:track-trend-training && npm run ml:track-trend:train && npm run ml:track-trend:predict && npm run ml:track-trend:import",
    "ml:artist-trajectory:train": "python ml/artist_trajectory_model.py --mode train --input output/artist_trajectory_features.csv",
    "ml:artist-trajectory:predict": "python ml/artist_trajectory_model.py --mode predict --input output/artist_trajectory_features.csv --output output/artist_trajectory_predictions.csv",
    "ml:artist-trajectory:import": "ts-node scripts/import_artist_trajectory_predictions.ts",
    "ml:artist-trajectory:full": "npm run export:artist-trajectory-features && npm run ml:artist-trajectory:train && npm run ml:artist-trajectory:predict && npm run ml:artist-trajectory:import",
    "ml:artist-spotify-trend:train": "python ml/artist_spotify_trend_model.py --mode train --input output/artist_spotify_trend_training.csv",
    "ml:artist-spotify-trend:predict": "python ml/artist_spotify_trend_model.py --mode predict --input output/artist_spotify_trend_training.csv --output output/artist_spotify_trend_predictions.csv",
    "ml:artist-spotify-trend:import": "ts-node scripts/import_artist_spotify_trend_predictions.ts",
    "ml:artist-spotify-trend:full": "npm run etl:artist-spotify-release-stats && npm run export:artist-spotify-trend-training && npm run ml:artist-spotify-trend:train && npm run ml:artist-spotify-trend:predict && npm run ml:artist-spotify-trend:import",
    "ml:retrain": "python -m ml.training.retrain_scheduler",
    "ml:neural:train": "python -m ml.neural.trainer",
    "ml:neural:full": "npm run ml:feedback:collect && npm run export:viral-training && npm run export:popularity-training && npm run export:trend-training && npm run ml:neural:train",
    "ml:service:start": "uvicorn ml.api.artist_trajectory_service:app --host 0.0.0.0 --port 8000 --reload",
    "ml:all:train": "npm run ml:viral:full && npm run ml:popularity:full && npm run ml:trend:full && npm run ml:artist-trajectory:full && npm run ml:neural:train"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "next": "14.1.0",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "postcss": "^8.5.15",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
