{
  "name": "music-intelligence-api",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:jobs": "tsc --noEmit -p tsconfig.jobs.json",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "smoke": "node --import tsx scripts/smoke.ts",
    "pentest": "node --import tsx scripts/pentest.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "create-tenant": "tsx scripts/create-tenant.ts",
    "create-api-key": "tsx scripts/create-api-key.ts",
    "tenant-automation": "tsx scripts/automation/tenantAutomation.ts",
    "match-catalog": "tsx scripts/match-catalog.ts",
    "etl:artist-daily": "tsx jobs/etl/artist_daily_stats.ts",
    "etl:artist-trajectory": "tsx jobs/etl/artist_trajectory_snapshots.ts",
    "etl:artist-all": "node scripts/run_artist_etl.js",
    "etl:track-trends": "tsx jobs/etl/track_trend_labels.ts",
    "etl:artist-spotify-release-stats": "tsx jobs/etl/artist_spotify_release_stats.ts",
    "etl:artist-spotify-release-labels": "tsx jobs/etl/artist_spotify_release_stats_labels.ts",
    "etl:ugc": "tsx jobs/etl/ugcTracks.ts",
    "ingest:spotify": "tsx jobs/ingest/spotify.ts",
    "ingest:tiktok": "tsx jobs/ingest/tiktok.ts",
    "ingest:youtube": "tsx jobs/ingest/youtube.ts",
    "ingest:luminate": "tsx jobs/ingest/luminate.ts",
    "ingest:soundcharts": "tsx jobs/ingest/soundcharts.ts",
    "ingest:radiostats": "tsx jobs/ingest/radiostats.ts",
    "ingest:billboard": "tsx jobs/ingest/billboard.ts",
    "ingest:crawl-dsp-apple": "tsx jobs/ingest/crawl_dsp_apple.ts",
    "ingest:crawl-social-x": "tsx jobs/ingest/crawl_social_x.ts",
    "ingest:crawl-radio-spins": "tsx jobs/ingest/crawl_radio_spins.ts",
    "export:artist-training": "tsx scripts/export_artist_trajectory_training.ts",
    "export:artist-trajectory-features": "tsx scripts/export_artist_trajectory_features.ts",
    "export:track-trend-training": "tsx scripts/export_track_trend_training.ts",
    "export:artist-spotify-trend-training": "tsx scripts/export_artist_spotify_trend_training.ts",
    "export:viral-training": "python ml/pipeline/feature_store.py --output data/viral_training_features.parquet",
    "export:popularity-training": "python ml/pipeline/feature_store.py --output data/popularity_training_features.parquet",
    "export:trend-training": "python ml/pipeline/feature_store.py --output data/trend_training_features.parquet",
    "ml:feedback:collect": "python ml/feedback/collector.py --since-days 30",
    "ml:viral:train": "python -m ml.training.train_viral_predictor",
    "ml:viral:full": "npm run export:viral-training && npm run ml:feedback:collect && npm run ml:viral:train",
    "ml:popularity:train": "python -m ml.training.train_popularity_predictor",
    "ml:popularity:full": "npm run export:popularity-training && npm run ml:feedback:collect && npm run ml:popularity:train",
    "ml:trend:train": "python -m ml.training.train_trend_classifier",
    "ml:trend:full": "npm run export:trend-training && npm run ml:feedback:collect && npm run ml:trend:train",
    "ml:track-trend:train": "python -m ml.track_trend_model --mode train --input output/track_trend_training.csv",
    "ml:track-trend:predict": "python -m ml.track_trend_model --mode predict --input output/track_trend_training.csv --output output/track_trend_predictions.csv",
    "ml:track-trend:import": "tsx scripts/import_track_trend_predictions.ts",
    "ml:track-trend:full": "npm run export:track-trend-training && npm run ml:track-trend:train && npm run ml:track-trend:predict && npm run ml:track-trend:import",
    "ml:artist-trajectory:train": "python -m ml.artist_trajectory_model --mode train --input output/artist_trajectory_features.csv",
    "ml:artist-trajectory:predict": "python -m ml.artist_trajectory_model --mode predict --input output/artist_trajectory_features.csv --output output/artist_trajectory_predictions.csv",
    "ml:artist-trajectory:import": "tsx scripts/import_artist_trajectory_predictions.ts",
    "ml:artist-trajectory:full": "npm run export:artist-trajectory-features && npm run ml:artist-trajectory:train && npm run ml:artist-trajectory:predict && npm run ml:artist-trajectory:import",
    "ml:artist-spotify-trend:train": "python -m ml.artist_spotify_trend_model --mode train --input output/artist_spotify_trend_training.csv",
    "ml:artist-spotify-trend:predict": "python -m ml.artist_spotify_trend_model --mode predict --input output/artist_spotify_trend_training.csv --output output/artist_spotify_trend_predictions.csv",
    "ml:artist-spotify-trend:import": "tsx scripts/import_artist_spotify_trend_predictions.ts",
    "ml:artist-spotify-trend:full": "npm run etl:artist-spotify-release-stats && npm run export:artist-spotify-trend-training && npm run ml:artist-spotify-trend:train && npm run ml:artist-spotify-trend:predict && npm run ml:artist-spotify-trend:import",
    "ml:retrain": "python -m ml.training.retrain_scheduler",
    "ml:neural:train": "python -m ml.neural.trainer",
    "ml:neural:full": "npm run ml:feedback:collect && npm run export:viral-training && npm run export:popularity-training && npm run export:trend-training && npm run ml:neural:train",
    "ml:service:start": "uvicorn ml.api.artist_trajectory_service:app --host 0.0.0.0 --port 8000 --reload",
    "ml:all:train": "npm run ml:viral:full && npm run ml:popularity:full && npm run ml:trend:full && npm run ml:artist-trajectory:full && npm run ml:neural:train",
    "ingest:googletrends": "npx tsx jobs/ingest/googletrends.ts",
    "ingest:shazam": "npx tsx jobs/ingest/shazam.ts",
    "etl:anomaly": "npx tsx jobs/etl/anomaly_detection.ts",
    "etl:log-predictions": "npx tsx jobs/etl/log_predictions.ts",
    "etl:evaluate-predictions": "npx tsx jobs/etl/evaluate_predictions.ts",
    "etl:reconcile": "npx tsx jobs/etl/reconcile.ts",
    "ml:backtest": "python -m ml.backtest_rankings",
    "create-user": "tsx scripts/create-user.ts",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^6.0.0",
    "@upstash/redis": "^1.34.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.22.4"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "google-trends-api": "^4.9.2",
    "postcss": "^8.5.15",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
